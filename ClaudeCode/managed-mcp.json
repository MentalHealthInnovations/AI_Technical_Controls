{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp?tools=all",
      "oauth": {
        "callbackPort": 33419
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_PAT}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,labels,actions,code_security,dependabot"
      }
    }
  }
}
