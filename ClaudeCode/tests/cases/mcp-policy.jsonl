# --- atlassian v2 meta-tools stay denied --------------------------------------
{"name":"atlassian discover denied","expect":"deny","tool_name":"mcp__atlassian__discover","input":{}}
{"name":"atlassian executeRead denied","expect":"deny","tool_name":"mcp__atlassian__executeRead","input":{}}
