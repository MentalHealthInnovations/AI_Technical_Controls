# Cases for mcp-policy-check.sh. Fields: name, expect (deny|allow|unset),
# tool_name (the full mcp__<server>__<tool> name), input (the tool_input object).
#
# The hook emits an explicit allow as well as an explicit deny, so a permitted tool
# expects "allow" rather than "unset". A non-MCP tool_name exits 0 with no decision,
# which the runner reports as "unset".
#
# --- server scoping ---------------------------------------------------------
{"name":"non-MCP tool passes through untouched","expect":"unset","tool_name":"Bash","input":{"command":"git status"}}
{"name":"unknown server denied (default-deny per server)","expect":"deny","tool_name":"mcp__notaserver__get_me","input":{}}
{"name":"malformed tool name denied","expect":"deny","tool_name":"mcp__github","input":{}}
# --- github reads -----------------------------------------------------------
{"name":"github get_me allowed, names no repository","expect":"allow","tool_name":"mcp__github__get_me","input":{}}
{"name":"github get_file_contents allowed, reads are not repo-scoped","expect":"allow","tool_name":"mcp__github__get_file_contents","input":{"owner":"SomeoneElse","repo":"unrelated","path":"README.md"}}
{"name":"github secret scanning read denied though GitHub would serve it","expect":"deny","tool_name":"mcp__github__list_secret_scanning_alerts","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls"}}
{"name":"github collaborator read denied as personal data","expect":"deny","tool_name":"mcp__github__list_repository_collaborators","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls"}}
# --- github writes omitted from the tool allowlist --------------------------
{"name":"github merge denied even in an allowlisted repo","expect":"deny","tool_name":"mcp__github__merge_pull_request","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","pullNumber":1}}
{"name":"github content write denied even in an allowlisted repo","expect":"deny","tool_name":"mcp__github__create_or_update_file","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","path":"x.txt","message":"m","content":"y"}}
{"name":"github repository deletion denied","expect":"deny","tool_name":"mcp__github__delete_repository","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls"}}
# --- github writes bound to GITHUB_REPOS ------------------------------------
{"name":"github issue comment allowed in an allowlisted repo","expect":"allow","tool_name":"mcp__github__add_issue_comment","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","issue_number":1,"body":"b"}}
{"name":"github issue comment allowed in a later-listed repo","expect":"allow","tool_name":"mcp__github__add_issue_comment","input":{"owner":"MentalHealthInnovations","repo":"translation","issue_number":1,"body":"b"}}
{"name":"github issue comment allowed case-insensitively","expect":"allow","tool_name":"mcp__github__add_issue_comment","input":{"owner":"mentalhealthinnovations","repo":"ai_technical_controls","issue_number":1,"body":"b"}}
{"name":"github issue comment denied outside GITHUB_REPOS","expect":"deny","tool_name":"mcp__github__add_issue_comment","input":{"owner":"MentalHealthInnovations","repo":"not-a-real-repo","issue_number":1,"body":"b"}}
{"name":"github issue comment denied for another owner's same-named repo","expect":"deny","tool_name":"mcp__github__add_issue_comment","input":{"owner":"Attacker","repo":"AI_Technical_Controls","issue_number":1,"body":"b"}}
{"name":"github issue write denied with no owner or repo (scope fails closed)","expect":"deny","tool_name":"mcp__github__issue_write","input":{"title":"t"}}
{"name":"github issue write denied with an empty repo","expect":"deny","tool_name":"mcp__github__issue_write","input":{"owner":"MentalHealthInnovations","repo":"","title":"t"}}
{"name":"github pull request write allowed in an allowlisted repo","expect":"allow","tool_name":"mcp__github__create_pull_request","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","title":"t","head":"h","base":"main"}}
{"name":"github create_branch allowed for a feature branch in an allowlisted repo","expect":"allow","tool_name":"mcp__github__create_branch","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","branch":"feat/x","from_branch":"main"}}
{"name":"github create_branch denied outside GITHUB_REPOS","expect":"deny","tool_name":"mcp__github__create_branch","input":{"owner":"MentalHealthInnovations","repo":"not-a-real-repo","branch":"feat/x"}}
{"name":"github push_files allowed to a feature branch in an allowlisted repo","expect":"allow","tool_name":"mcp__github__push_files","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","branch":"feat/x","message":"m","files":[{"path":"docs/x.md","content":"y"},{"path":"ClaudeCode/opt/claude/hooks/x.sh","content":"y"}]}}
{"name":"github push_files denied outside GITHUB_REPOS","expect":"deny","tool_name":"mcp__github__push_files","input":{"owner":"Attacker","repo":"AI_Technical_Controls","branch":"feat/x","message":"m","files":[{"path":"docs/x.md","content":"y"}]}}
{"name":"github push_files with a file lacking a path denied","expect":"deny","tool_name":"mcp__github__push_files","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","branch":"feat/x","message":"m","files":[{"content":"y"}]}}
{"name":"github push_files of a PII-named file denied","expect":"deny","tool_name":"mcp__github__push_files","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","branch":"feat/x","message":"m","files":[{"path":"fixtures/users.csv","content":"y"}]}}
{"name":"github push_files denied when one file of several is PII-named","expect":"deny","tool_name":"mcp__github__push_files","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","branch":"feat/x","message":"m","files":[{"path":"docs/x.md","content":"y"},{"path":"data/referrals/2026-01.txt","content":"y"}]}}
{"name":"github review write denied outside GITHUB_REPOS","expect":"deny","tool_name":"mcp__github__pull_request_review_write","input":{"owner":"MentalHealthInnovations","repo":"not-a-real-repo","pullNumber":1}}
# --- github review approvals stay with a person -----------------------------
{"name":"github review APPROVE denied in an allowlisted repo","expect":"deny","tool_name":"mcp__github__pull_request_review_write","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","pullNumber":1,"method":"create","event":"APPROVE"}}
{"name":"github pending review submitted as approve denied, case folded","expect":"deny","tool_name":"mcp__github__pull_request_review_write","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","pullNumber":1,"method":"submit_pending","event":"approve"}}
{"name":"github review APPROVE outside GITHUB_REPOS denied","expect":"deny","tool_name":"mcp__github__pull_request_review_write","input":{"owner":"MentalHealthInnovations","repo":"not-a-real-repo","pullNumber":1,"method":"create","event":"APPROVE"}}
{"name":"github review COMMENT allowed in an allowlisted repo","expect":"allow","tool_name":"mcp__github__pull_request_review_write","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","pullNumber":1,"method":"create","event":"COMMENT","body":"b"}}
{"name":"github review REQUEST_CHANGES allowed in an allowlisted repo","expect":"allow","tool_name":"mcp__github__pull_request_review_write","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","pullNumber":1,"method":"create","event":"REQUEST_CHANGES","body":"b"}}
{"name":"github review thread resolve allowed with no event","expect":"allow","tool_name":"mcp__github__pull_request_review_write","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","pullNumber":1,"method":"resolve_thread","threadId":"t"}}
# --- github file reads answer to the PII path policy ------------------------
{"name":"github file read of a PII-named file denied","expect":"deny","tool_name":"mcp__github__get_file_contents","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","path":"fixtures/users.csv"}}
{"name":"github file read under a PII directory denied","expect":"deny","tool_name":"mcp__github__get_file_contents","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","path":"data/referrals/2026-01.txt"}}
{"name":"github file read of a record dump denied","expect":"deny","tool_name":"mcp__github__get_file_contents","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls","path":"customers.json"}}
{"name":"github file read with no path allowed","expect":"allow","tool_name":"mcp__github__get_file_contents","input":{"owner":"MentalHealthInnovations","repo":"AI_Technical_Controls"}}
# --- atlassian must be unaffected by the github additions -------------------
{"name":"atlassian read allowed in an allowlisted project","expect":"allow","tool_name":"mcp__atlassian__getJiraIssue","input":{"issueIdOrKey":"PLAN-1"}}
{"name":"atlassian read denied outside ATLASSIAN_PROJECTS","expect":"deny","tool_name":"mcp__atlassian__getJiraIssue","input":{"issueIdOrKey":"VST-1"}}
{"name":"atlassian tool not on the allowlist denied","expect":"deny","tool_name":"mcp__atlassian__search","input":{"query":"x"}}
