# of the space whose key is APAD, and each name has its own entry on the list.
{"name":"confluence space lookup by allowlisted key allowed","expect":"allow","tool_name":"mcp__atlassian__getConfluenceSpace","input":{"spaceIdOrKey":"APAD"}}
{"name":"confluence space lookup folds key case","expect":"allow","tool_name":"mcp__atlassian__getConfluenceSpace","input":{"spaceIdOrKey":"apad"}}
