{"name":"atlassian v2 project list allowed","expect":"allow","tool_name":"mcp__atlassian__listJiraProjects","input":{}}
{"name":"atlassian v2 link types allowed","expect":"allow","tool_name":"mcp__atlassian__listJiraIssueLinkTypes","input":{}}
{"name":"atlassian v1 transition name denied","expect":"deny","tool_name":"mcp__atlassian__getTransitionsForJiraIssue","input":{"issueIdOrKey":"PLAN-1"}}
