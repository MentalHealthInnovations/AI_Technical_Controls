{"name":"confluence space lookup by other key denied","expect":"deny","tool_name":"mcp__atlassian__getConfluenceSpace","input":{"spaceIdOrKey":"MPSC"}}
{"name":"confluence space lookup by listed alias allowed","expect":"allow","tool_name":"mcp__atlassian__getConfluenceSpace","input":{"spaceIdOrKey":"PMQMS"}}
{"name":"confluence space lookup by other id denied","expect":"deny","tool_name":"mcp__atlassian__getConfluenceSpace","input":{"spaceIdOrKey":"123456"}}
