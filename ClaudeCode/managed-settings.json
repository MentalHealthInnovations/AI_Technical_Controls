{
  "allowedChannelPlugins": [],
  "allowedHttpHookUrls": [],
  "allowedMcpServers": [],
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "alwaysThinkingEnabled": false,
  "channelsEnabled": false,
  "companyAnnouncements": ["You must read and adhere to the MHI Use of Artificial Intelligence policy at https://mentalhealthinnovations.atlassian.net/wiki/spaces/MPSC/pages/4485349381/MHI+Use+of+Artificial+Intelligence. See technical controls at https://github.com/MentalHealthInnovations/AI_Technical_Controls"],
  "disableAutoMode": "disable",
  "disableDeepLinkRegistration": "disable",
  "disableSkillShellExecution": true,
  "enabledMcpjsonServers": [],
  "feedbackSurveyRate": 0,
  "forceLoginMethod": "claudeai",
  "forceRemoteSettingsRefresh": true,
  "strictKnownMarketplaces": [],

  "autoConnectIde": false,
  "autoInstallIdeExtension": true,
  "editorMode": "normal",
  "externalEditorContext": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,

  "permissions": {
    "additionalDirectories": [],
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.terraform.d/**)",
      "Read(~/.terraformrc)",
      "Read(~/.vault-token)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.cargo/credentials)",
      "Read(~/.config/op/**)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ecdsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/*_rsa)",
      "Read(./**/*credentials*)",
      "Read(./**/*secret*)",
      "Read(./**/*token*)",

      "Read(/etc/passwd)",
      "Read(/etc/shadow)",

      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./**/*.p12)",
      "Edit(./**/*.pfx)",
      "Edit(./**/*.jks)",
      "Edit(./**/id_rsa)",
      "Edit(./**/id_ecdsa)",
      "Edit(./**/id_ed25519)",
      "Edit(./**/*_rsa)",
      "Edit(./**/*credentials*)",
      "Edit(./**/*secret*)",
      "Edit(./**/*token*)",

      "Edit(./.git/hooks/**)",
      "Edit(./.git/config)",
      "Edit(./.git/packed-refs)",
      "Edit(./.husky/**)",
      "Edit(./.pre-commit-config.yaml)",
      "Edit(./**/.pre-commit-config.yaml)",
      "Write(./.pre-commit-config.yaml)",
      "Write(./**/.pre-commit-config.yaml)",
      "Edit(/Library/Application Support/ClaudeCode/**)",

      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)",
      "Write(./secrets/**)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",
      "Write(./**/*.p12)",
      "Write(./**/*.pfx)",
      "Write(./**/*.jks)",
      "Write(./**/id_rsa)",
      "Write(./**/id_ecdsa)",
      "Write(./**/id_ed25519)",
      "Write(./**/*_rsa)",
      "Write(./**/*credentials*)",
      "Write(./**/*secret*)",
      "Write(./**/*token*)",

      "Write(./.git/hooks/**)",
      "Write(./.git/config)",
      "Write(./.git/packed-refs)",
      "Write(./.husky/**)",
      "Write(/Library/Application Support/ClaudeCode/**)",

      "WebSearch(*)"
    ]
  },

  "sandbox": {
    "enabled": true,
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "ignoreViolations": {},
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [],
    "allowUnsandboxedCommands": false,

    "filesystem": {
      "allowRead": [
        "."
      ],
      "allowWrite": [
        ".",
        "./tmp",
        "./build",
        "./dist",
        "./coverage",
        "./.git/refs/**",
        "./.git/objects/**",
        "./.git/logs/**",
        "./.git/COMMIT_EDITMSG",
        "./.git/MERGE_MSG",
        "./.git/MERGE_HEAD",
        "./.git/index",
        "./.git/index.lock",
        "./.git/HEAD",
        "./.git/HEAD.lock",
        "./.git/ORIG_HEAD",
        "./.git/FETCH_HEAD",
        "./.git/packed-refs",
        "./.git/packed-refs.lock"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.config/gcloud",
        "~/.gnupg",
        "~/.npmrc",
        "~/.netrc",
        "~/.docker",
        "~/.kube",
        "~/.terraform.d",
        "~/.terraformrc",
        "~/.vault-token",
        "~/Library/Keychains",
        "~/.config/gh",
        "~/.pypirc",
        "~/.gem",
        "~/.cargo/credentials",
        "~/.config/op"
      ],
      "denyWrite": [
        "/etc",
        "/usr/local/bin",
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.config/gcloud",
        "~/.gnupg",
        "~/.npmrc",
        "~/.netrc",
        "~/.docker",
        "~/.kube",
        "~/.terraform.d",
        "~/.terraformrc",
        "~/.vault-token",
        "~/Library/Keychains"
      ],
      "allowManagedReadPathsOnly": true
    },

    "network": {
      "_comment_allowedDomains": "Source of truth for the WebFetch domain allowlist. webfetch-policy-check.sh reads this list at runtime, so adding or removing a hostname here updates both the OS sandbox and the hook in lockstep. Bare hostnames only — no subdomain wildcards (list each subdomain explicitly) and no path component (a '/' makes the entry invalid). The OS sandbox allows every path on a listed host; to narrow WebFetch to a path prefix, add the host to _webfetchPathScopes below.",
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "crates.io",
        "index.crates.io",
        "opentofu.org",
        "developer.hashicorp.com",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "hub.docker.com",
        "public.ecr.aws",
        "api.ecr-public.aws",
        "mentalhealthinnovations.org",
        "themix.org.uk",
        "giveusashout.org",
        "code.claude.com",
        "www.twilio.com",
        "learn.jamf.com",
        "learn.microsoft.com",
        "community.jamf.com",
        "docs.aws.amazon.com",
        "pricing.us-east-1.amazonaws.com",
        "developer.salesforce.com",
        "docs.github.com"
      ],
      "_comment_webfetchPathScopes": "WebFetch-only path tightening, read solely by webfetch-policy-check.sh. Each key is a host that also appears in allowedDomains; its value is a path prefix that WebFetch URLs to that host must fall under (exact match or a '/'-bounded child). Hosts not listed here are unrestricted. This does NOT constrain Bash network egress — the OS sandbox sees host only and allows every path — so treat it as a WebFetch convenience/blast-radius control, not a hard boundary.",
      "_webfetchPathScopes": {
        "opentofu.org": "/docs",
        "developer.hashicorp.com": "/terraform"
      },
      "allowManagedDomainsOnly": true
    }
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/bash-policy-check.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/webfetch-policy-check.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Task|SlashCommand|Read",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/tool-audit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/output-redact.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/prompt-submit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/session-audit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/session-audit.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/session-audit.sh"
          }
        ]
      }
    ]
  }
}
